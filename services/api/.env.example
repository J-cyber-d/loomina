# =====================================================================
# 1. LOOMINA METADATA DATABASE (PostgreSQL + Drizzle ORM)
# Stores users, organizations, dashboards, widgets, and encrypted credentials
# =====================================================================
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/loomina_metadata

# =====================================================================
# 2. EMBEDDED SDK AUTHENTICATION
# HMAC-SHA256 secret used to sign and verify guest JWTs in RAM (<0.2ms)
# =====================================================================
LOOMINA_EMBED_SECRET=dev_embed_secret_key_98765

# =====================================================================
# 3. BETTER AUTH (Developer Studio Admin Console)
# =====================================================================
BETTER_AUTH_SECRET=dev_better_auth_secret_random_string_32chars
BETTER_AUTH_URL=http://localhost:4000

# =====================================================================
# 4. FASTIFY API GATEWAY PORT
# =====================================================================
PORT=4000
